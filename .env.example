# TSR Enterprises - environment configuration (copy to .env and fill in)

# Google OAuth (admin/viewer login)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Session
SECRET_KEY=generate-a-long-random-string
SESSION_MAX_AGE=86400

# PostgreSQL (Neon / Render / local)
DATABASE_URL=postgresql://user:password@host:5432/tsr_enterprises

# Google Drive document storage
GOOGLE_DRIVE_FOLDER_ID=your-drive-root-folder-id
SERVICE_ACCOUNT_FILE=service_account.json
# Or paste the full service account JSON (takes priority over the file)
GOOGLE_CREDENTIALS_JSON=

# Emails allowed to bootstrap as admin (comma separated)
ALLOWED_EMAILS=owner@example.com

# Firebase Phone Authentication (driver OTP login)
# From Firebase console -> Project settings -> General -> Your apps (Web app)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id

# Legacy driver OTP SMS - used only when Firebase is not configured
FAST2SMS_API_KEY=
